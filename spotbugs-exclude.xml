<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!--
        Storing or returning Bukkit / plugin objects (Player, JavaPlugin, ItemStack, etc.) is
        intentional and idiomatic in a Spigot/Paper plugin: these objects are owned by the server
        and shared by reference on purpose. The EI_EXPOSE family (MALICIOUS_CODE) therefore produces
        only false positives here, so it is excluded to keep the gate focused on real defects.
    -->
    <Match>
        <Bug category="MALICIOUS_CODE"/>
    </Match>
</FindBugsFilter>
